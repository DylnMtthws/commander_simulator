{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "deck_identity",
    "simulation_input_sha256",
    "games",
    "turns",
    "commander_cast_count",
    "lands_mean",
    "commander_draws_mean",
    "cast_samples",
    "assumptions"
  ],
  "properties": {
    "schema_version": {
      "const": "resource-probe-result.v1"
    },
    "scenario": {
      "const": "commander-land-engine-only.v1"
    },
    "deck_identity": {
      "type": "string"
    },
    "simulation_input_sha256": {
      "type": "string"
    },
    "games": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000
    },
    "turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "commander_cast_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000
    },
    "lands_mean": {
      "type": "number",
      "minimum": 0
    },
    "commander_draws_mean": {
      "type": "number",
      "minimum": 0
    },
    "cast_samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
